{
  "name": "ai-drama-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Five-act desktop production workspace",
  "author": "AI Drama Studio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "playwright test",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "postinstall": "node node_modules/electron/install.js",
    "format": "prettier --write src tests *.ts *.mts *.json",
    "format:check": "prettier --check src tests",
    "verify": "npm run typecheck && npm test && npm run build",
    "package:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "ffprobe-static": "^3.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED"
}
